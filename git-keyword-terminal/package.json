{
  "name": "git-keyword-terminal",
  "displayName": "Git Keyword Terminal",
  "description": "키워드로 Git 작업을 VS Code 통합 터미널에서 실행합니다.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:gitKeywordTerminal.runKeyword",
    "onCommand:gitKeywordTerminal.openConfig",
    "workspaceContains:git-keywords.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitKeywordTerminal.runKeyword",
        "title": "Git Keyword Terminal: 키워드 실행"
      },
      {
        "command": "gitKeywordTerminal.openConfig",
        "title": "Git Keyword Terminal: 키워드 설정 열기"
      }
    ],
    "configuration": {
      "title": "Git Keyword Terminal",
      "properties": {
        "gitKeywordTerminal.terminalName": {
          "type": "string",
          "default": "Git Keyword Terminal",
          "description": "키워드 명령을 실행할 VS Code 통합 터미널 이름입니다."
        }
      }
    }
  }
}
