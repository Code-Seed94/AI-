{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Git Keyword Terminal Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/git-keyword-terminal"
      ]
    }
  ]
}
